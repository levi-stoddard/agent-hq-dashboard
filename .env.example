# Copy to .env (gitignored) and export the values before starting the server. The server does not read .env itself.
# Leave a value empty to use the default described next to it.

# Token that unlocks the gated Command Board write routes (POST /api/jobs, POST /api/sync/reconcile).
# Empty keeps those routes locked (403). If you enable them, generate a long random value yourself.
# HQ_WRITE_SESSION_TOKEN=your-long-random-write-token-here
HQ_WRITE_SESSION_TOKEN=

# Folder with the JSON state files, relative to this repository. Empty uses sample-state/ (fictional data).
# AHQ_STATE_DIR=path/to/your/state-folder
AHQ_STATE_DIR=

# Optional supervisor state file, relative to this repository. Empty uses sample-state/launcher_state.json (not shipped).
# AHQ_SUPERVISOR_STATE_FILE=path/to/supervisor-state.json
AHQ_SUPERVISOR_STATE_FILE=

# Loopback ports that Mission Control probes. Empty uses 8780, 8770 and 8771.
# AHQ_SIM_VAULT_PORT=8780
AHQ_SIM_VAULT_PORT=
# AHQ_CALIBRATION_PORT=8770
AHQ_CALIBRATION_PORT=
# AHQ_VAULT_RUNTIME_PORT=8771
AHQ_VAULT_RUNTIME_PORT=
